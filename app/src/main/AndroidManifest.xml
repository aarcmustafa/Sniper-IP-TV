<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════
         الصلاحيات الأساسية
    ═══════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- ✅ قراءة الملفات التي يختارها المستخدم فقط -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ═══════════════════════════════════════════════════════════
         مميزات الأجهزة
    ═══════════════════════════════════════════════════════════ -->

    <!-- ✅ required=false — للسماح بالتثبيت على كل أجهزة Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- ✅ التطبيق لا يحتاج لمس -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!-- ✅ أجهزة USB للـ M3U من Flash Drive -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- ✅ يدعم Gamepad (بعض أجهزة TV) -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!-- ✅ الشاشة الأفقية (TV دائمًا landscape) -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!-- ═══════════════════════════════════════════════════════════
         Queries — للسماح بفتح روابط الفيديو في تطبيقات خارجية
    ═══════════════════════════════════════════════════════════ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/dash+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/mp2t" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/x-matroska" />
        </intent>
    </queries>

    <!-- ═══════════════════════════════════════════════════════════
         Application
    ═══════════════════════════════════════════════════════════ -->
    <application
        android:name=".StittenApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="34"
        android:theme="@style/Theme.STTITENIPTV">

        <!-- ═══════════════════════════════════════════════════════
             Main Activity — Landscape + LEANBACK
        ═══════════════════════════════════════════════════════ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.STTITENIPTV">

            <!-- LAUNCHER — للأجهزة العادية -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- LEANBACK_LAUNCHER — يظهر في Android TV Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════════════════════════════════════════
             Media Session Service — للتحكم من الريموت
        ═══════════════════════════════════════════════════════ -->
        <service
            android:name=".player.PlaybackService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- ═══════════════════════════════════════════════════════
             FileProvider — لمشاركة ملفات APK / M3U
        ═══════════════════════════════════════════════════════ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
